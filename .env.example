GOOGLE_API_KEY=replace-with-your-google-api-key

# Authentication
AUTH_ENABLED=true
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Seed administrator. The alias "admin" maps to this email.
ADMIN_EMAIL=admin@local

# Local development fallback only. Default login: admin / admin
ENABLE_DEV_ADMIN_LOGIN=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin

# Email OTP. For local development, OTP_DEBUG displays/logs the code.
OTP_DEBUG=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_DB_PATH=data/auth.db

# Configure these for real email delivery and set OTP_DEBUG=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# DeepEval judge model
USE_GEMINI_MODEL=1
GEMINI_MODEL_NAME=gemini-2.5-flash
